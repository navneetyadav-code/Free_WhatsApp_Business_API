APP_ENV=local
APP_NAME="WhatsApp API Hub"
APP_BASE_PATH=/whatsapp-api/public
APP_SESSION_NAME=wa_api_hub
APP_SECURE_COOKIES=false
ENABLE_TEST_PAGE=true

DB_DSN="mysql:host=127.0.0.1;dbname=whatsapp_api;charset=utf8mb4"
DB_HOST=127.0.0.1
DB_USER=whatsapp_api_app
DB_PASSWORD=change-this-db-password
DB_NAME=whatsapp_api

WORKER_URL=http://127.0.0.1:3107
WORKER_TOKEN=change-this-worker-token-before-production
WA_SESSION_DIR=C:\xampp\whatsapp-api-data\sessions

DEFAULT_COUNTRY_CODE=91
SEND_DELAY_MS=2500
QUEUE_POLL_MS=3000
LOG_LEVEL=warn
